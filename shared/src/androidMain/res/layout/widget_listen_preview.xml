<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of Listen (Android 12 and later): the wide card. Synthetic text and cover only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_preview_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_author"
            android:textColor="#FFC2C2C7"
            android:textSize="13sp" />

        <ProgressBar
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:progress="70"
            android:progressBackgroundTint="#FF6B6B70"
            android:progressTint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_time_left"
            android:textColor="#FFC2C2C7"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/widget_play_circle" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FF19191B" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
