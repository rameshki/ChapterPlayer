<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of Listen (Android 12 and later): the standard size with the controls. Synthetic text only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF151A2B"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_title"
        android:textColor="#FFF0EDE8"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_chapter"
        android:textColor="#FFAEABA4"
        android:textSize="12sp" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:progress="25"
        android:progressBackgroundTint="#FF1E2742"
        android:progressTint="#FFE8B84B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_previous_chapter"
            android:tint="#FFE8B84B" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_back"
            android:tint="#FFE8B84B" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_pause"
            android:tint="#FFE8B84B" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_forward"
            android:tint="#FFE8B84B" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next_chapter"
            android:tint="#FFE8B84B" />
    </LinearLayout>
</LinearLayout>
