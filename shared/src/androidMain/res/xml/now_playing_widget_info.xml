<?xml version="1.0" encoding="utf-8"?>
<!-- One cell wide: play/pause only. From about three cells: title, back 15, play/pause, forward 30. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_now_playing_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:previewImage="@drawable/widget_preview_now_playing"
    android:previewLayout="@layout/widget_now_playing_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
