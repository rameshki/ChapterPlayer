<?xml version="1.0" encoding="utf-8"?>
<!--
  Listen: Resume, then the playback controls. Placed at four by two cells (title, progress and the controls);
  two cells wide or one tall it is one row (play/pause and the title); about three cells tall it adds the cover.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_listen_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewImage="@drawable/widget_preview_listen"
    android:previewLayout="@layout/widget_listen_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
