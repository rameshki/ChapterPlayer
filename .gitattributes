# Text files are stored with LF and checked out with LF on every machine.
* text=auto eol=lf

# Batch files for Windows keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.jks binary
*.keystore binary
*.jar binary
*.zip binary
*.ipa binary
*.apk binary
*.aab binary
