<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground ("Midnight and Gold").
     Drawn on a 108 viewport (headphones over an open book). The drawing's bounding box (y 29 to 78) is centred
     in the tile and scaled by 0.85, the most that keeps its furthest points (the cup corners) inside the 66 dp
     safe zone circle that every launcher mask keeps. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="53.5"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateY="0.5">
        <!-- Headband -->
        <path
            android:pathData="M28,58 A26,26 0 0,1 80,58"
            android:strokeColor="#FFF2C14E"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- Ear cups -->
        <path
            android:fillColor="#FFF2C14E"
            android:pathData="M25.5,52 L27.5,52 A5.5,5.5 0 0,1 33,57.5 L33,70.5 A5.5,5.5 0 0,1 27.5,76 L25.5,76 A5.5,5.5 0 0,1 20,70.5 L20,57.5 A5.5,5.5 0 0,1 25.5,52 Z" />
        <path
            android:fillColor="#FFF2C14E"
            android:pathData="M80.5,52 L82.5,52 A5.5,5.5 0 0,1 88,57.5 L88,70.5 A5.5,5.5 0 0,1 82.5,76 L80.5,76 A5.5,5.5 0 0,1 75,70.5 L75,57.5 A5.5,5.5 0 0,1 80.5,52 Z" />
        <!-- Open book -->
        <group android:translateX="0">
            <path
                android:fillColor="#FFF2C14E"
                android:pathData="M54,78 C48,73 41,71 36,72.5 L36,54 C41,52.5 48,54 54,59 Z" />
        </group>
        <group android:translateX="0">
            <path
                android:fillColor="#FFC9973A"
                android:pathData="M54,78 C60,73 67,71 72,72.5 L72,54 C67,52.5 60,54 54,59 Z" />
        </group>
    </group>
</vector>
