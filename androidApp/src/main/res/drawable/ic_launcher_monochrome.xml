            android:fillColor="#FFFFFFFF"
            android:pathData="M47.5,39.5 A2,2 0 0,1 49.5,41.5 L49.5,48.5 A2,2 0 0,1 47.5,50.5 A2,2 0 0,1 45.5,48.5 L45.5,41.5 A2,2 0 0,1 47.5,39.5 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,37 A2,2 0 0,1 56,39 L56,51 A2,2 0 0,1 54,53 A2,2 0 0,1 52,51 L52,39 A2,2 0 0,1 54,37 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M60.5,39.5 A2,2 0 0,1 62.5,41.5 L62.5,48.5 A2,2 0 0,1 60.5,50.5 A2,2 0 0,1 58.5,48.5 L58.5,41.5 A2,2 0 0,1 60.5,39.5 Z" />
        <path
