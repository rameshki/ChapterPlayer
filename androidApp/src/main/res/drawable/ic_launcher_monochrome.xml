            android:fillColor="#FFFFFFFF"
            android:pathData="M41,42 A2,2 0 0,1 43,44 L43,46 A2,2 0 0,1 41,48 A2,2 0 0,1 39,46 L39,44 A2,2 0 0,1 41,42 Z" />
